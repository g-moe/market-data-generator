{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"ignorePatterns": ["data-out/**", "dist/**", "node_modules/**"],
	"plugins": ["typescript", "unicorn", "oxc", "import", "vitest"],
	"jsPlugins": [
		{
			"name": "custom-no-js-date-time",
			"specifier": "./.linting/oxlint.no-js-date-time.js"
		}
	],
	"rules": {
		"no-debugger": "error",
		"no-unused-vars": [
			"warn",
			{
				"varsIgnorePattern": "^_"
			}
		],
		"sort-keys": "error",
		"typescript/no-useless-default-assignment": "off",
		"custom-no-js-date-time/no-js-date-time": "error"
	}
}
