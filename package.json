{
	"name": "market-data-generator",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"generate": "tsx src/run.ts",
		"generate:without": "tsx src/run-without-cli.ts",
		"dev": "tsx watch src/run.ts",
		"build": "tsc --project ./tsconfig.build.json",
		"test": "vitest",
		"coverage": "vitest run --coverage",
		"prepare": "husky",
		"check": "tsgo --noEmit --project ./tsconfig.json",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"dependencies": {
		"@clack/prompts": "^1.5.0"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"@typescript/native-preview": "7.0.0-dev.20260527.2",
		"@vitest/coverage-v8": "4.1.7",
		"husky": "9.1.7",
		"oxfmt": "0.52.0",
		"oxlint": "1.67.0",
		"tsx": "^4.22.4",
		"typescript": "6.0.3",
		"vitest": "4.1.7"
	},
	"engines": {
		"node": "24.16.0"
	},
	"packageManager": "pnpm@11.5.2"
}
