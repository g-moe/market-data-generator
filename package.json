{
	"name": "market-data-generator",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"setup": "bash ./scripts/setup-dev.sh",
		"build": "tsc --project ./tsconfig.build.json",
		"test": "vitest --project unit",
		"coverage": "vitest run --coverage --project unit",
		"test:e2e:sierra": "vitest run --project e2e src/__tests__/__e2e__/sierra/sierra.e2e.test.ts",
		"test:e2e:md-generation": "vitest run --project e2e src/__tests__/__e2e__/md-generation/md-generation.e2e.test.ts",
		"knip": "knip",
		"typecheck": "tsgo --noEmit --project ./tsconfig.json",
		"lint": "oxlint --fix",
		"format": "oxfmt --write",
		"check": "pnpm run typecheck && pnpm run lint && pnpm run format && pnpm run knip",
		"run-md-generate": "tsx src/run-md-generate.ts",
		"run-sierra-generate": "tsx src/run-sierra-generate.ts",
		"run:options": "tsx src/run-options.ts"
	},
	"dependencies": {
		"@js-temporal/polyfill": "0.5.1"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"@typescript/native-preview": "7.0.0-dev.20260527.2",
		"@vitest/coverage-v8": "4.1.7",
		"husky": "9.1.7",
		"knip": "6.15.0",
		"oxfmt": "0.52.0",
		"oxlint": "1.67.0",
		"tsx": "4.22.4",
		"typescript": "6.0.3",
		"vitest": "4.1.7"
	},
	"engines": {
		"node": "24.16.0"
	},
	"packageManager": "pnpm@11.5.2"
}
